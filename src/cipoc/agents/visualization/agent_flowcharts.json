    },
    {
      "selector": "edge[kind = \"loop\"]",
      "style": {
        "line-style": "dotted",
        "curve-style": "unbundled-bezier"
      }
    },
    {
      "selector": "edge[kind = \"fanout\"]",
      "style": {
        "line-style": "dashed",
        "curve-style": "unbundled-bezier",
        "control-point-weights": 0.5
      }
    },
    {
      "selector": "edge[fanout_lane = \"left\"]",
